FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
ENV GOMAXPROCS=2 GOFLAGS=-p=2
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN test -z "$(gofmt -l internal/cloudflare/credentials*.go internal/cloudflare/types.go internal/selfhost*.go internal/signaling/handler.go internal/signaling/peer.go cmd/signaling/main.go)" && go test ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /signaling ./cmd/signaling
FROM scratch
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/VoxelBoy/netlib" \
      org.opencontainers.image.revision=$VCS_REF
COPY --from=build /signaling /signaling
USER 65532:65532
ENTRYPOINT ["/signaling"]
